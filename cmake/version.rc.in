// Version resource for @VI_FILENAME@, generated by swml_version_info() in CMakeLists.txt.
#pragma code_page(65001)
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VI_V1@,@VI_V2@,@VI_V3@,0
 PRODUCTVERSION @VI_V1@,@VI_V2@,@VI_V3@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @VI_FILETYPE@
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@VI_COMPANY@"
            VALUE "FileDescription", "@VI_DESCRIPTION@"
            VALUE "FileVersion", "@VI_VERSION@"
            VALUE "InternalName", "@VI_INTERNAL@"
            VALUE "LegalCopyright", "Copyright (C) @VI_COMPANY@"
            VALUE "OriginalFilename", "@VI_FILENAME@"
            VALUE "ProductName", "@VI_PRODUCT@"
            VALUE "ProductVersion", "@VI_VERSION@"
            VALUE "Comments", "@VI_COMMENTS@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
